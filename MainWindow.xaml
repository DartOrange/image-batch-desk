<Window x:Class="ImageBatchDesk.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Image Batch Desk" Style="{StaticResource {x:Type Window}}" Width="1260" Height="900" MinWidth="1020" MinHeight="740" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="FilesDropped" DragOver="FilesDragged" Closing="WindowClosing" PreviewKeyDown="WindowKeyDown">
 <Grid Margin="30,24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal"><Border Background="#146D5E" CornerRadius="12" Width="48" Height="48" Margin="0,0,14,0"><Grid><Rectangle Width="23" Height="18" Stroke="White" StrokeThickness="2" RadiusX="2" RadiusY="2" Margin="0,0,6,6"/><Rectangle Width="23" Height="18" Stroke="#B8DEAC" StrokeThickness="2" RadiusX="2" RadiusY="2" Margin="6,6,0,0"/></Grid></Border><StackPanel><TextBlock Text="IMAGE BATCH DESK" FontSize="12" FontWeight="Bold" Foreground="#146D5E"/><TextBlock Text="Small files. Big possibilities." FontSize="26" FontWeight="SemiBold"/></StackPanel></StackPanel>
   <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="LOCAL BY DESIGN" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/><TextBlock Text="Offline · Originals stay untouched" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel>
  </Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="306"/></Grid.ColumnDefinitions>
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="230"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,16"><TextBlock DockPanel.Dock="Left" Text="01 / Your images" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="SamplesButton" Content="Try samples" Click="LoadSamples"/><Button x:Name="AddButton" Content="+ Add images" Click="AddImages" Background="#172F39" Foreground="White" BorderBrush="#172F39" Margin="0" ToolTip="Choose PNG or JPEG files (Ctrl+O)"/></StackPanel></DockPanel>
    <Border Grid.Row="1" Background="#E6EBE3" CornerRadius="12" BorderBrush="#D3DDD1" BorderThickness="1" Padding="18">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
      <Image x:Name="Preview" Stretch="Uniform" Margin="0,0,18,0" RenderOptions.BitmapScalingMode="HighQuality"/>
      <StackPanel x:Name="EmptyPreview" VerticalAlignment="Center" Grid.ColumnSpan="2" HorizontalAlignment="Center"><TextBlock Text="A lighter batch starts here." FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Drop PNG or JPEG images anywhere in this window,&#10;or try the original sample collection." Foreground="#526A58" TextAlignment="Center" Margin="0,10,0,0"/></StackPanel>
      <StackPanel x:Name="PreviewDetails" Grid.Column="1" VerticalAlignment="Center" Visibility="Collapsed"><TextBlock Text="SOURCE PREVIEW" FontSize="10" FontWeight="Bold" Foreground="#526A58"/><TextBlock x:Name="PreviewName" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,10"/><TextBlock x:Name="PreviewSize" Foreground="#526A58"/><TextBlock Text="Aspect ratio preserved.&#10;Smaller images stay small." FontSize="12" Foreground="#526A58" Margin="0,18,0,0"/></StackPanel>
     </Grid>
    </Border>
    <DockPanel Grid.Row="2" Margin="0,18,0,10"><StackPanel Orientation="Horizontal"><TextBlock x:Name="QueueCount" Text="No images yet" FontWeight="SemiBold"/><TextBlock Text=" · PNG / JPEG · up to 500 files" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="RemoveButton" Content="Remove selected" Padding="9,5" Click="RemoveSelected" FontSize="12"/><Button x:Name="ClearButton" Content="Clear" Padding="9,5" Click="ClearQueue" FontSize="12" Margin="0"/></StackPanel></DockPanel>
    <Border Grid.Row="3" Background="White" CornerRadius="8" BorderBrush="#D4DDD8" BorderThickness="1" ClipToBounds="True">
     <DataGrid x:Name="Queue" ItemsSource="{Binding Rows}" SelectionMode="Extended" SelectionUnit="FullRow" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" GridLinesVisibility="None" HeadersVisibility="Column" RowHeaderWidth="0" BorderThickness="0" Background="White" RowBackground="White" AlternatingRowBackground="#F6F8F5" HorizontalScrollBarVisibility="Auto" SelectionChanged="SelectionChanged" FontSize="12" RowHeight="56" ColumnHeaderHeight="34" EnableRowVirtualization="True">
      <DataGrid.Resources><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#EDF1EB"/><Setter Property="Foreground" Value="#526A58"/><Setter Property="Padding" Value="12,8"/><Setter Property="FontWeight" Value="SemiBold"/></Style><Style TargetType="DataGridCell"><Setter Property="Padding" Value="12,5"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Detail}"/></Style></DataGrid.Resources>
      <DataGrid.Columns>
       <DataGridTemplateColumn Header="IMAGE" Width="*" MinWidth="160"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontWeight="SemiBold"/><TextBlock Text="{Binding Dimensions}" Foreground="#526A70" FontSize="11"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTemplateColumn Header="OUTPUT" Width="*" MinWidth="160"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Output}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Output}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="100"/>
      </DataGrid.Columns>
     </DataGrid>
    </Border>
   </Grid>
   <Border Grid.Column="2" Background="White" CornerRadius="12" BorderBrush="#D4DDD8" BorderThickness="1" Padding="22">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <TextBlock Text="02 / Make it lighter" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBlock Text="One recipe for the whole batch." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,22"/>
     <StackPanel x:Name="SettingsPanel">
      <Label Target="{Binding ElementName=EdgeBox}" Content="Maximum edge · pixels" Padding="0" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Muted}"/>
      <TextBox x:Name="EdgeBox" Text="1600" TextChanged="SettingsChanged" AutomationProperties.Name="Maximum edge in pixels"/>
      <TextBlock Text="Fits inside this size. Never enlarges." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,-8,0,16"/>
      <Label Target="{Binding ElementName=FormatBox}" Content="Output format" Padding="0" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Muted}"/>
      <ComboBox x:Name="FormatBox" SelectedIndex="0" SelectionChanged="SettingsChanged" AutomationProperties.Name="Output format"><ComboBoxItem Content="JPEG"/><ComboBoxItem Content="PNG"/></ComboBox>
      <Label Target="{Binding ElementName=QualityBox}" Content="JPEG quality · 1–100" Padding="0" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Muted}"/>
      <TextBox x:Name="QualityBox" Text="88" TextChanged="SettingsChanged" AutomationProperties.Name="JPEG quality"/>
      <Label Target="{Binding ElementName=SuffixBox}" Content="Filename suffix" Padding="0" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Muted}"/>
      <TextBox x:Name="SuffixBox" Text="small" TextChanged="SettingsChanged" AutomationProperties.Name="Filename suffix"/>
      <TextBlock Text="DESTINATION" Style="{StaticResource Label}" Margin="0,3,0,7"/>
      <Button Content="Choose output folder…" Click="ChooseDestination" Margin="0,0,0,8"/>
      <TextBlock x:Name="DestinationLabel" Text="Choose a separate folder to preview names." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,18" MaxHeight="32" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>
     </StackPanel>
     <Border Background="#EDF4EF" CornerRadius="7" Padding="12"><StackPanel><TextBlock Text="A fresh copy. Every time." FontWeight="SemiBold" FontSize="12"/><TextBlock Text="Existing files get a numbered name. Metadata is removed; JPEG uses a white background." FontSize="11" Foreground="#426354" Margin="0,5,0,0"/></StackPanel></Border>
    </StackPanel></ScrollViewer>
   </Border>
  </Grid>
  <Border Grid.Row="2" Background="#172F39" CornerRadius="12" Padding="20,16" Margin="0,22,0,0">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Margin="0,0,20,0"><TextBlock x:Name="StatusText" Text="Ready when you are." Foreground="White" FontWeight="SemiBold"/><TextBlock x:Name="StatusDetail" Text="Add images, choose a destination, then start your batch." Foreground="#BECFCC" FontSize="12" Margin="0,4,0,0"/><ProgressBar x:Name="Progress" Height="4" Margin="0,10,0,0" Foreground="#A9D7A2" Background="#3F5960" BorderThickness="0" Maximum="100"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="OpenButton" Content="Open output" Click="OpenOutput" Visibility="Collapsed"/><Button x:Name="CancelButton" Content="Cancel" Click="CancelBatch" Visibility="Collapsed"/><Button x:Name="StartButton" Content="Process batch →" Click="StartBatch" Background="#BDE4A9" BorderBrush="#BDE4A9" Margin="0" IsEnabled="False"/></StackPanel></Grid>
  </Border>
 </Grid>
</Window>
